# ============================================================
# LEO Rigging AI — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ─────────────────────────────────────────────
# ⚠️  SECURITY WARNING — READ BEFORE USE
# ─────────────────────────────────────────────
# A real OpenAI API key was previously committed to Git history
# in this repository. You MUST:
#   1. Revoke the exposed key at https://platform.openai.com/api-keys
#   2. Review API usage and billing for unauthorized charges.
#   3. Create a replacement key.
#   4. Store the replacement ONLY here in this untracked .env file
#      or in a proper secret manager (Vault, AWS Secrets Manager, etc.)
#   5. Purge the old secret from Git history separately (git filter-repo
#      or BFG Repo Cleaner) after explicit repository-owner authorization.
# ─────────────────────────────────────────────

# ─── Application ────────────────────────────
# ENVIRONMENT: "development" | "production"
# In production: /docs, /redoc, /openapi.json are disabled.
ENVIRONMENT=development

# ─── API Authentication ──────────────────────
# Comma-separated list of valid API keys (bearer tokens).
# Format: <key>:<role>  where role is one of:
#   query | documents:read | documents:write | documents:delete | admin
# Multiple keys allowed. Example:
#   API_KEYS=keyA:query,keyB:admin
# Leave AUTH_ENABLED=false for local dev only.
AUTH_ENABLED=true
API_KEYS=trsey67e47yi7b6urytkunyum85jhg:admin

# ─── CORS ────────────────────────────────────
# Comma-separated list of allowed origins.
# NEVER use "*" in production with credentials enabled.
CORS_ALLOW_ORIGINS=http://localhost:3000

# ─── Trusted Hosts ───────────────────────────
# Comma-separated list of allowed Host header values.
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── OpenAI ──────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ─── Embeddings ──────────────────────────────
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_BATCH=64

# ─── Vector Store ────────────────────────────
VECTOR_DB=chroma
CHROMA_COLLECTION=leo_rigging_ai
# CHROMA_DB_DIR defaults to app/data/vectorstore

# ─── Chunking ────────────────────────────────
CHUNK_TOKENS=600
CHUNK_OVERLAP=120

# ─── Retrieval ───────────────────────────────
TOPK_DENSE=12
TOPK_BM25=12
TOPK_AFTER_MMR=10
HYBRID_WEIGHT_DENSE=0.55
HYBRID_WEIGHT_BM25=0.45
MMR_LAMBDA=0.6
# Minimum blended relevance score to use a chunk in context.
# Chunks below this score trigger a grounded refusal.
MIN_RELEVANCE_SCORE=0.35

# ─── Reranker (optional) ─────────────────────
USE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_TOPN=20

# ─── OCR / Tesseract ─────────────────────────
TESSERACT_LANGS=eng
OCR_DPI_SCALE=2.0
MIN_EXTRACTED_TEXT=25
OCR_MAX_PAGES=500
OCR_MAX_PIXELS=50000000

# ─── Upload Limits ───────────────────────────
MAX_UPLOAD_FILES=10
# Max bytes per individual file (default: 50 MB)
MAX_FILE_BYTES=52428800
# Max total request bytes (default: 200 MB)
MAX_TOTAL_REQUEST_BYTES=209715200
MAX_PDF_PAGES=500

# ─── Rate Limiting ───────────────────────────
# Format: "<count> per <period>" e.g. "30 per minute"
RATE_LIMIT_QUERY=30 per minute
RATE_LIMIT_UPLOAD=10 per minute
RATE_LIMIT_ADMIN=60 per minute

# ─── Logging ─────────────────────────────────
LOG_LEVEL=INFO
# Set to true to emit structured JSON logs
LOG_JSON=false

# ─── Chroma batch optimization ───────────────
CHROMA_BATCH_SIZE=1000
