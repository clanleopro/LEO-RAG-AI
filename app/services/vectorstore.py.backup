# app/services/vectorstore.py
"""
Vector store service — Chroma + BM25 hybrid retrieval.

Improvements over original:
- Domain-aware BM25 tokenizer that preserves standards codes, model
  numbers, units, hyphenated terms, and acronyms.
- Genuine MMR using cosine similarity between candidate embeddings.
- Embedding model stored in collection metadata; mismatch detected at startup.
- Chunk metadata includes checksum, ingestion timestamp, embedding model,
  and version/revision.
- delete_by_source atomically removes Chroma vectors and BM25 entries.
- Thread-safe BM25 rebuild with a read-write lock.
- get_collection_embedding_model() for mismatch detection.

⚠️  PRODUCTION NOTE on BM25:
The BM25 index is in-memory and process-local. It is only safe for
single-worker deployments. For multi-worker production:
  Option A: Use a Chroma HTTP server (single process) and disable BM25.
  Option B: Replace BM25 with a Redis/Elasticsearch-backed lexical index.
  Option C: Use a single gunicorn worker (--workers 1) with the local Chroma.
"""
from __future__ import annotations

import hashlib
import logging
import re
import threading
import time
from dataclasses import dataclass, field
from typing import Dict, List, Optional, Tuple

import chromadb
import numpy as np
from chromadb.config import Settings
from rank_bm25 import BM25Okapi

from . import config, embeddings

log = logging.getLogger(__name__)

# ─────────────────────────────────────────────────────────────
# Data types
# ─────────────────────────────────────────────────────────────

@dataclass
class Chunk:
    id: Optional[str]
    text: str
    source: str
    page: int
    doc_id: Optional[str] = None
    headings: Optional[List[str]] = None
    language: Optional[str] = None
    standard_code: Optional[str] = None
    embedding: Optional[np.ndarray] = field(default=None, repr=False, compare=False)
    checksum: Optional[str] = None
    ingested_at: Optional[str] = None
    embedding_model: Optional[str] = None
    version: Optional[str] = None


@dataclass
class SearchHit:
    id: str
    text: str
    source: str
    doc_id: str
    page: int
    score_vec: float
    score_bm25: float
    score_blended: float = 0.0
    version: Optional[str] = None


# ─────────────────────────────────────────────────────────────
# Helpers
# ─────────────────────────────────────────────────────────────

def _meta_primitive(v):
    """Convert a non-null value to a Chroma-compatible metadata value."""
    if isinstance(v, (str, int, float, bool)):
        return v
    if isinstance(v, np.bool_):
        return bool(v)
    if isinstance(v, np.integer):
        return int(v)
    if isinstance(v, np.floating):
        return float(v)
    if isinstance(v, (list, tuple, set)):
        return ", ".join(str(x) for x in v if x is not None)
    return str(v)


def _clean_metadata(values: Dict) -> Dict:
    """
    Remove null values and normalize the remainder for Chroma.

    Chroma metadata values must be scalar strings, integers, floats, or
    booleans. Optional Chunk fields are intentionally omitted when unset.
    """
    return {
        str(key): _meta_primitive(value)
        for key, value in values.items()
        if value is not None
    }


# ─── Domain-aware BM25 tokenizer ──────────────────────────────
# Preserves:
#   - Standards codes: ASME, B30.9, ISO 4308, EN 13411
#   - Units: kg, kN, lb, lbf, mm, in, ft, SWL, WLL, SF, MBL
#   - Hyphenated terms: wire-rope, load-bearing
#   - Acronyms: PPE, MOB, SWL, WLL, DCRN, OSHA
#   - Model numbers: CM-750, YaleGrip-2T

_TOKEN_RE = re.compile(
    r"""
    [A-Z]{2,}(?:-\d+)?          |  # Acronyms / standards: ASME, SWL, ISO-4308
    [A-Za-z0-9]+-[A-Za-z0-9]+  |  # Hyphenated: wire-rope, CM-750
    \d+(?:\.\d+)?(?:kg|kN|lb|lbf|mm|in|ft|m|t|°)?  |  # Numeric with unit
    [a-zA-Z]{2,}                   # Regular words (≥2 chars)
    """,
    re.VERBOSE,
)

_STOP_WORDS = frozenset({
    "the", "a", "an", "is", "in", "of", "to", "and", "or", "for",
    "on", "at", "by", "be", "as", "it", "its", "with", "this", "that",
    "are", "was", "were", "will", "be", "been", "has", "have", "had",
    "do", "does", "did", "can", "could", "may", "should", "would",
    "from", "into", "than", "then", "so", "if", "not", "but",
})


def _tokenize(s: str) -> List[str]:
    """
    Domain-aware tokenizer for BM25.
    Returns normalized tokens preserving industry-specific terms.
    """
    if not s:
        return []
    tokens = _TOKEN_RE.findall(s)
    result = []
    for t in tokens:
        tl = t.lower()
        if tl not in _STOP_WORDS and len(tl) >= 2:
            result.append(tl)
    return result


def _deterministic_id(source: str, page: int, text: str) -> str:
    h = hashlib.sha256()
    h.update((source or "").encode("utf-8"))
    h.update(str(page).encode("utf-8"))
    h.update((text or "")[:1024].encode("utf-8"))
    return h.hexdigest()[:32]


def _parse_max_batch_from_msg(msg: str) -> Optional[int]:
    m = re.search(r"max batch size of (\d+)", msg)
    return int(m.group(1)) if m else None


def _norm(vals: List[float]) -> List[float]:
    if not vals:
        return []
    arr = np.array(vals, dtype=np.float32)
    if float(arr.std()) < 1e-6:
        mx = float(abs(arr).max())
        return [float(v / (mx + 1e-6)) for v in arr]
    z = (arr - arr.mean()) / (arr.std() + 1e-6)
    z_min, z_max = float(z.min()), float(z.max())
    return [float((v - z_min) / (z_max - z_min + 1e-6)) for v in z]


# ─────────────────────────────────────────────────────────────
# Chroma client
# ─────────────────────────────────────────────────────────────

_client = chromadb.PersistentClient(
    path=str(config.VECTOR_DIR),
    settings=Settings(anonymized_telemetry=False),
)
_COLLECTION_NAME = config.ENV.CHROMA_COLLECTION or "leo_rigging_ai"


def _get_collection():
    try:
        return _client.get_collection(_COLLECTION_NAME)
    except Exception:
        return _client.create_collection(
            _COLLECTION_NAME,
            metadata={"embedding_model": config.ENV.EMBED_MODEL, "created": time.time()},
        )


def get_collection_embedding_model() -> Optional[str]:
    """Return the embedding model recorded in the collection metadata."""
    try:
        coll = _client.get_collection(_COLLECTION_NAME)
        meta = coll.metadata or {}
        return meta.get("embedding_model")
    except Exception:
        return None


# ─────────────────────────────────────────────────────────────
# BM25 index (process-local; single-worker only)
# ─────────────────────────────────────────────────────────────

_bm25_lock = threading.RLock()
_BM25: Optional[BM25Okapi] = None
_BM25_IDS: List[str] = []
_BM25_TEXTS: List[str] = []


def rebuild_bm25_index() -> None:
    global _BM25, _BM25_IDS, _BM25_TEXTS
    coll = _get_collection()
    new_ids: List[str] = []
    new_texts: List[str] = []

    offset = 0
    page_size = 1000
    while True:
        res = coll.get(limit=page_size, offset=offset, include=["documents"])
        ids = res.get("ids", [])
        docs = res.get("documents", [])
        if not ids:
            break
        new_ids.extend(ids)
        new_texts.extend(docs)
        offset += len(ids)

    corpus = [_tokenize(t) for t in new_texts]
    with _bm25_lock:
        _BM25_IDS = new_ids
        _BM25_TEXTS = new_texts
        _BM25 = BM25Okapi(corpus) if corpus else None

    log.info("BM25 index rebuilt: %d documents", len(new_ids))


# ─────────────────────────────────────────────────────────────
# Public API
# ─────────────────────────────────────────────────────────────

def upsert_chunks(chunks: List[Chunk]) -> int:
    if not chunks:
        return 0
    coll = _get_collection()

    # De-duplicate by (source, page, text)
    seen_triplet: set = set()
    seen_ids: set = set()
    uniq: List[Chunk] = []
    for c in chunks:
        key = (c.source, int(c.page), (c.text or "").strip())
        if key in seen_triplet:
            continue
        seen_triplet.add(key)
        uniq.append(c)

    ids: List[str] = []
    docs: List[str] = []
    metas: List[Dict] = []
    vecs_list: List[Optional[np.ndarray]] = []
    missing_texts: List[str] = []

    for c in uniq:
        cid = (c.id or _deterministic_id(c.source, c.page, c.text or "")).strip()
        if cid in seen_ids:
            continue
        seen_ids.add(cid)

        ids.append(cid)
        docs.append(c.text or "")
        meta_raw = {
            "source": c.source,
            "doc_id": c.doc_id or c.source,
            "page": int(c.page),
            "headings": c.headings,
            "language": c.language,
            "standard_code": c.standard_code,
            "checksum": c.checksum,
            "ingested_at": c.ingested_at,
            "embedding_model": c.embedding_model or config.ENV.EMBED_MODEL,
            "version": c.version,
        }
        metas.append(_clean_metadata(meta_raw))

        if c.embedding is None:
            missing_texts.append(c.text or "")
            vecs_list.append(None)
        else:
            vecs_list.append(c.embedding)

    if missing_texts:
        # Passage embeddings for document chunks
        new_vecs = embeddings.embed(missing_texts, is_query=False)
        j = 0
        for i in range(len(vecs_list)):
            if vecs_list[i] is None:
                vecs_list[i] = new_vecs[j]
                j += 1

    if len(ids) != len(docs) or len(ids) != len(metas) or len(ids) != len(vecs_list):
        raise RuntimeError("Inconsistent Chroma upsert payload lengths")
    if any(v is None for v in vecs_list):
        raise RuntimeError("One or more chunk embeddings could not be generated")

    if not ids:
        return 0

    batch_size = max(1, config.ENV.CHROMA_BATCH_SIZE)
    start = 0
    while start < len(ids):
        end = min(start + batch_size, len(ids))
        try:
            coll.upsert(
                ids=ids[start:end],
                documents=docs[start:end],
                metadatas=metas[start:end],
                embeddings=[
                    (v.tolist() if hasattr(v, "tolist") else v)
                    for v in vecs_list[start:end]
                ],
            )
            start = end
        except Exception as e:
            msg = str(e)
            hinted = _parse_max_batch_from_msg(msg)
            if hinted is not None and hinted < batch_size:
                log.warning("Chroma hinted max batch=%d (was %d). Reducing.", hinted, batch_size)
                batch_size = max(1, hinted)
            else:
                # A smaller batch cannot repair invalid metadata, embeddings,
                # authentication, storage, or other deterministic failures.
                raise

    rebuild_bm25_index()
    return len(ids)


def delete_by_source(source_filename: str) -> int:
    """Delete all chunks for a given source filename."""
    coll = _get_collection()
    res = coll.get(where={"source": source_filename})
    ids = res.get("ids", []) if isinstance(res, dict) else []
    if ids:
        coll.delete(ids=ids)
    rebuild_bm25_index()
    return len(ids)


def delete_by_doc_id(doc_id: str) -> int:
    """Delete all chunks for a given doc_id."""
    coll = _get_collection()
    try:
        res = coll.get(where={"doc_id": doc_id})
    except Exception:
        res = coll.get(where={"source": doc_id})
    ids = res.get("ids", []) if isinstance(res, dict) else []
    if ids:
        coll.delete(ids=ids)
    rebuild_bm25_index()
    return len(ids)


def get_chunk_by_id(chunk_id: str) -> Optional[Dict]:
    """Retrieve a single chunk by its Chroma ID (for citation verification)."""
    try:
        coll = _get_collection()
        res = coll.get(ids=[chunk_id], include=["documents", "metadatas"])
        if res.get("ids"):
            return {
                "id": res["ids"][0],
                "text": (res.get("documents") or [""])[0],
                "meta": (res.get("metadatas") or [{}])[0],
            }
    except Exception:
        pass
    return None


def wipe() -> None:
    try:
        _client.delete_collection(_COLLECTION_NAME)
    except Exception:
        pass
    rebuild_bm25_index()


def list_sources() -> List[Dict]:
    coll = _get_collection()
    total = coll.count()

    if total > 0:
        sample_res = coll.get(
            limit=min(total, 100),
            include=["metadatas"],
        )
        metas = sample_res.get("metadatas") or []
    else:
        metas = []

    sources = sorted({
        m.get("source")
        for m in metas
        if isinstance(m, dict) and m.get("source")
    })

    return [{
        "collection": _COLLECTION_NAME,
        "count": total,
        "sample_sources": sources,
    }]


def list_documents() -> List[Dict]:
    """Return a deduplicated list of documents with their metadata."""
    coll = _get_collection()
    res = coll.get(include=["metadatas"])
    metas = res.get("metadatas") or []

    seen: Dict[str, Dict] = {}
    for m in metas:
        if not m:
            continue
        key = m.get("doc_id") or m.get("source") or ""
        if key and key not in seen:
            seen[key] = {
                "doc_id": key,
                "title": m.get("source", key),
                "checksum": m.get("checksum"),
                "ingested_at": m.get("ingested_at"),
                "embedding_model": m.get("embedding_model"),
                "version": m.get("version"),
            }

    return list(seen.values())


# ─────────────────────────────────────────────────────────────
# Hybrid search
# ─────────────────────────────────────────────────────────────

def hybrid_search(
    query: str,
    topk_dense: int,
    topk_bm25: int,
    filter_doc: Optional[str] = None,
) -> List[SearchHit]:
    coll = _get_collection()

    collection_count = coll.count()
    if collection_count == 0:
        return []

    # Query embedding with query prefix
    q_vec = embeddings.embed_one(query, is_query=True).tolist()

    # ── Dense retrieval ──────────────────────────────────────
    query_kwargs: Dict = dict(
        query_embeddings=[q_vec],
        n_results=min(max(1, topk_dense), collection_count),
        include=["documents", "metadatas", "distances"],
    )
    if filter_doc:
        query_kwargs["where"] = {"source": filter_doc}

    try:
        dres = coll.query(**query_kwargs)
    except Exception as exc:
        log.warning("Dense query failed: %s", exc)
        dres = {"ids": [[]], "documents": [[]], "metadatas": [[]], "distances": [[]]}

    ids_d = dres.get("ids", [[]])[0]
    docs_d = dres.get("documents", [[]])[0]
    metas_d = dres.get("metadatas", [[]])[0]
    dists = dres.get("distances", [[]])[0]

    dense_sims: Dict[str, float] = {}
    dense_payload: Dict[str, Tuple[str, Dict]] = {}
    for i, _id in enumerate(ids_d):
        # Chroma returns L2 distance; convert to cosine similarity
        sim = max(0.0, 1.0 - float(dists[i])) if i < len(dists) else 0.0
        dense_sims[_id] = sim
        t = docs_d[i] if i < len(docs_d) else ""
        m = metas_d[i] if i < len(metas_d) else {}
        dense_payload[_id] = (t, m)

    # ── BM25 retrieval ───────────────────────────────────────
    bm25_scores: Dict[str, float] = {}
    with _bm25_lock:
        bm25 = _BM25
        bm25_ids = list(_BM25_IDS)
        bm25_texts = list(_BM25_TEXTS)

    if bm25 is not None and bm25_ids:
        scores = bm25.get_scores(_tokenize(query))
        top_idx = np.argsort(scores)[::-1][:topk_bm25]
        for idx in top_idx:
            if idx < len(bm25_ids):
                bm25_scores[bm25_ids[idx]] = float(scores[idx])

    # ── Merge and normalize ──────────────────────────────────
    keys: List[str] = []
    merged: Dict[str, Dict[str, float]] = {}

    for _id, sim in dense_sims.items():
        if _id not in merged:
            keys.append(_id)
            merged[_id] = {}
        merged[_id]["score_vec"] = sim

    for _id, score in bm25_scores.items():
        if _id not in merged:
            keys.append(_id)
            merged[_id] = {}
        merged[_id]["score_bm25"] = score

    dense_vals = [merged[k].get("score_vec", 0.0) for k in keys]
    bm25_vals = [merged[k].get("score_bm25", 0.0) for k in keys]
    ndense = _norm(dense_vals)
    nbm25 = _norm(bm25_vals)

    # Fetch BM25-only payloads from Chroma
    bm25_only_ids = [k for k in keys if k not in dense_payload]
    bm25_payload: Dict[str, Tuple[str, Dict]] = {}
    if bm25_only_ids:
        try:
            got = coll.get(ids=bm25_only_ids, include=["documents", "metadatas"])
            for _id, text, meta in zip(
                got.get("ids", []),
                got.get("documents", []),
                got.get("metadatas", []),
            ):
                bm25_payload[_id] = (text, meta)
        except Exception as exc:
            log.warning("BM25 payload fetch failed: %s", exc)

    # Build hits
    hits: List[SearchHit] = []
    w_d = config.ENV.HYBRID_WEIGHT_DENSE
    w_b = config.ENV.HYBRID_WEIGHT_BM25

    for i, _id in enumerate(keys):
        dv = ndense[i] if i < len(ndense) else 0.0
        bv = nbm25[i] if i < len(nbm25) else 0.0
        blended = w_d * dv + w_b * bv

        if _id in dense_payload:
            text, meta = dense_payload[_id]
        else:
            text, meta = bm25_payload.get(_id, ("", {}))

        source = meta.get("source", "") if isinstance(meta, dict) else ""
        doc_id = meta.get("doc_id", source) if isinstance(meta, dict) else source
        page = int(meta.get("page", 0)) if isinstance(meta, dict) else 0
        version = meta.get("version") if isinstance(meta, dict) else None

        # Apply document filter for BM25-only hits
        if filter_doc and source != filter_doc:
            continue

        hits.append(SearchHit(
            id=_id,
            text=text or "",
            source=source,
            doc_id=doc_id,
            page=page,
            score_vec=dv,
            score_bm25=bv,
            score_blended=blended,
            version=version,
        ))

    return hits


# ─────────────────────────────────────────────────────────────
# Real MMR using cosine similarity between embeddings
# ─────────────────────────────────────────────────────────────

def mmr_diverse(
    hits: List[SearchHit],
    top_k: int,
    lambda_mult: float = 0.6,
) -> List[SearchHit]:
    """
    Maximum Marginal Relevance selection using actual cosine similarity
    between candidate chunk embeddings.

    This is a genuine MMR implementation, not a heuristic.
    Falls back to blended-score ranking if embeddings cannot be fetched.
    """
    if not hits:
        return []
    if len(hits) <= top_k:
        return sorted(hits, key=lambda h: h.score_blended, reverse=True)

    # Fetch embeddings for all candidate hits
    hit_ids = [h.id for h in hits]
    try:
        coll = _get_collection()
        res = coll.get(ids=hit_ids, include=["embeddings"])
        emb_map: Dict[str, np.ndarray] = {}
        for _id, emb in zip(res.get("ids", []), res.get("embeddings", [])):
            if emb is not None:
                emb_map[_id] = np.array(emb, dtype=np.float32)
    except Exception as exc:
        log.warning("MMR embedding fetch failed (%s); falling back to blended sort.", exc)
        return sorted(hits, key=lambda h: h.score_blended, reverse=True)[:top_k]

    # If any embeddings are missing, fall back
    if len(emb_map) < len(hits):
        log.debug("MMR: %d/%d embeddings available; using blended sort.", len(emb_map), len(hits))
        return sorted(hits, key=lambda h: h.score_blended, reverse=True)[:top_k]

    selected: List[SearchHit] = []
    remaining = list(hits)

    while remaining and len(selected) < top_k:
        best: Optional[SearchHit] = None
        best_score = float("-inf")

        for candidate in remaining:
            relevance = candidate.score_blended
            if not selected:
                mmr_score = relevance
            else:
                c_emb = emb_map.get(candidate.id)
                if c_emb is None:
                    sim_to_selected = 0.0
                else:
                    sims = []
                    for sel in selected:
                        s_emb = emb_map.get(sel.id)
                        if s_emb is not None:
                            dot = float(np.dot(c_emb, s_emb))
                            norm = float(np.linalg.norm(c_emb) * np.linalg.norm(s_emb))
                            sims.append(dot / (norm + 1e-8))
                    sim_to_selected = max(sims) if sims else 0.0

                mmr_score = lambda_mult * relevance - (1.0 - lambda_mult) * sim_to_selected

            if mmr_score > best_score:
                best_score = mmr_score
                best = candidate

        if best is not None:
            selected.append(best)
            remaining.remove(best)

    return selected


# ─────────────────────────────────────────────────────────────
# Convenience query wrapper
# ─────────────────────────────────────────────────────────────

def query(q_or_emb, top_k: int = 10, filter_doc: Optional[str] = None):
    """
    Compatibility wrapper for legacy callers.
    Prefer calling hybrid_search + mmr_diverse directly.
    """
    if isinstance(q_or_emb, str):
        hits = hybrid_search(
            q_or_emb,
            topk_dense=config.ENV.TOPK_DENSE,
            topk_bm25=config.ENV.TOPK_BM25,
            filter_doc=filter_doc,
        )
        hits = mmr_diverse(hits, top_k=top_k, lambda_mult=config.ENV.MMR_LAMBDA)
        documents = [[h.text for h in hits]]
        metadatas = [[{"source": h.source, "page": h.page} for h in hits]]
        distances = [[float(1.0 - h.score_blended) for h in hits]]
        return {"documents": documents, "metadatas": metadatas, "distances": distances}

    coll = _get_collection()
    q_vec = q_or_emb.tolist() if isinstance(q_or_emb, np.ndarray) else q_or_emb
    kwargs: Dict = dict(
        query_embeddings=[q_vec],
        n_results=top_k,
        include=["documents", "metadatas", "distances"],
    )
    if filter_doc:
        kwargs["where"] = {"source": filter_doc}
    return coll.query(**kwargs)
